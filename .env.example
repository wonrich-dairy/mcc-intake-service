# Docker Compose environment variables
# Copy this file to .env and fill in values

# MySQL passwords (defaults are set in docker-compose.yml for local dev)
MYSQL_ROOT_PASSWORD=RootDevPassword123!
MYSQL_PASSWORD=DevPassword123!

# Kafka (SCRUM-88) - broker connection, never committed with real values
# Read by docker-compose.kafka.yml, which attaches the service to the broker that
# processing-service's compose stack runs. See docs/kafka.md.
# Local compose: the broker is kafka:9092 inside the network, localhost:29092 from the host.
# Staging/production: the Azure Event Hubs Kafka endpoint, which needs the SASL settings below.
Kafka__BootstrapServers=kafka:9092
Kafka__SecurityProtocol=Plaintext

# Event Hubs only. SaslUsername is the literal token $ConnectionString, not a variable to expand;
# SaslPassword is the namespace connection string and is a secret.
# Kafka__SecurityProtocol=SaslSsl
# Kafka__SaslMechanism=Plain
# Kafka__SaslUsername=$ConnectionString
# Kafka__SaslPassword=YOUR_EVENTHUBS_CONNECTION_STRING

# Name of the Docker network the broker is on. processing-service's compose project is named after
# its folder, so this is only different if that checkout is called something else.
# KAFKA_NETWORK=processing-service_default
