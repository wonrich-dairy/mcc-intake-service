# Docker Compose environment variables
# Copy this file to .env and fill in values

# MySQL passwords (defaults are set in docker-compose.yml for local dev)
MYSQL_ROOT_PASSWORD=RootDevPassword123!
MYSQL_PASSWORD=DevPassword123!

# Auth (SCRUM-34) - must match the auth service that issues the tokens. The signing key is at
# least 32 characters and is a secret everywhere except a local stack; the compose default is
# for local development only.
AUTH_ISSUER=wonrich-auth
AUTH_AUDIENCE=wonrich-services
AUTH_SIGNING_KEY=local-development-signing-key-not-for-any-real-environment-0123456789
