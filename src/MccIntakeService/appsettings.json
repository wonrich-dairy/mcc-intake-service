{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Intake": {
    "DailyCutoff": "16:00",
    "TimeZone": "Asia/Colombo"
  },
  "QualityThresholds": {
    "MinimumFatPercent": 3.5,
    "MinimumSnf": 8.5,
    "MinimumCorrectedClr": 26.0,
    "MaximumWaterPercent": 0.5,
    "WorstAcceptableStability": "MarginallyStable",
    "WorstAcceptableKqColour": "Purple"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kafka": {
    "BootstrapServers": "",
    "SecurityProtocol": "Plaintext"
  },
  "ConsignmentTested": {
    "Topic": "wonrich.mcc.consignment-tested.v1",
    "MarginalMargin": 0.10
  },
  "Outbox": {
    "RelayEnabled": true,
    "MaxRetries": 20,
    "BatchSize": 20,
    "DeadLetterTopic": "wonrich.dlq.mcc-consignment-tested.v1"
  }
}
