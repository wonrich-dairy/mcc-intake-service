<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    SCRUM-50 requires this library to be versioned and consumed as a package rather than copied
    source, so that the MCC service and the Lab service provably run the same calculations. The
    package metadata lives here; publishing to the feed is the pipeline's job (SCRUM-37).
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Wonrich.QualityPanel</PackageId>
    <Version>1.0.0</Version>
    <Authors>Wonrich Dairy</Authors>
    <Description>
      Shared milk quality test panel: CLR temperature correction, SNF and TS composition, the
      alcohol stability cascade and the KQ colour scale, with thresholds read from configuration.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
